# 앱 설정 템플릿. 실제 설정 파일은 레포 밖에 둔다:
#   ~/.config/postmortem-rag/rag.env   (scripts/init_config.sh 가 이 템플릿을 복사해 만듦, 권한 600)
# 이 템플릿에는 실제 값을 넣지 마세요.

APP_ENV=prod
PORT=8000

# 데이터 위치 (기본값: 프로젝트의 data/)
# DATA_DIR=

# 2단계 수집기. CRAWL_CONTACT는 User-Agent에 붙는 연락처(이메일이나 URL).
# 비워두면 연락처 없이 요청합니다. CRAWL_DELAY_SEC는 같은 호스트 요청 간격(기본 3초).
CRAWL_CONTACT=
CRAWL_DELAY_SEC=

# 6단계(/ask)에서 사용. 지금은 비워둬도 됩니다.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
